#!/usr/bin/env bash

# Set to true when going directly to a submenu, so we can exit directly
BACK_TO_EXIT=false

back_to() {
  local parent_menu="$1"

  if [[ "$BACK_TO_EXIT" == "true" ]]; then
    exit 0
  elif [[ -n "$parent_menu" ]]; then
    "$parent_menu"
  else
    show_main_menu
  fi
}

menu() {
    local prompt="$1"
    local options="$2"
    local extra="$3"
    local preselect="$4"

    read -r -a args <<<"$extra"

    if [[ -n "$preselect" ]]; then
        local index
        index=$(echo -e "$options" | grep -nxF "$preselect" | cut -d: -f1)
        if [[ -n "$index" ]]; then
            args+=("-a" "$index")
        fi
    fi

    echo -e "$options" | rofi -dmenu -p "$prompt…" "${args[@]}" -sync
}

show_apps() {
    rofi -show drun -replace -i
}

show_session_menu() {
    case $(menu "System" " Lock\n󱄄 Log out\n󰤄 Suspend\n󰜉 Restart\n󰐥 Shutdown\n Back" "-no-show-icons") in
        *Lock*) m-sessionctl lock ;;
        *"Log out"*) m-sessionctl exit ;;
        *Suspend*) m-sessionctl suspend ;;
        *Restart*) m-sessionctl reboot ;;
        *Shutdown*) m-sessionctl shutdown ;;
        *Back*) back_to show_main_menu ;;
        *) back_to show_main_menu ;;
    esac
}

show_screenshot_menu() {
    case $(menu "System" " Window\n󰍹 Monitor\n Region\n Back" "-no-show-icons") in
        *Window*) m-screenshot window ;;
        *Monitor*) m-screenshot monitor ;;
        *Region*) m-screenshot region ;;
        *Back*) back_to show_main_menu ;;
        *) back_to show_main_menu ;;
    esac
}

show_main_menu() {
    go_to_menu "$(menu "Go" " Apps\n Session\n󱎘 Close menu\n󱣵 Screenshot" "-no-show-icons")"
}

go_to_menu() {
    case "${1,,}" in
        *apps*) show_apps;;
        *session*) show_session_menu;;
        *screenshot*) show_screenshot_menu;;
        *close*) exit 0;;
    esac
}

if [[ -n "$1" ]]; then
    BACK_TO_EXIT=true
    go_to_menu "$1"
else
    show_main_menu
fi
