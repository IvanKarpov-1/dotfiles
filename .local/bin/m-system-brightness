#!/usr/bin/env bash

# /* ---- 💫 https://github.com/JaKooLit 💫 ---- */  ##
# Script for display and keyboard backlights using brightnessctl

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}"
iDIR="$config_dir/swaync/icons"
notification_timeout=1000
step=10  # INCREASE/DECREASE BY THIS VALUE

# Get current brightness as an integer (without %)
get_brightness() {
    brightnessctl -m | cut -d, -f4 | tr -d '%'
}

# Get keyboard brightness
get_kbd_backlight() {
	brightnessctl -d '*::kbd_backlight' -m | cut -d, -f4
}

# Determine the icon based on brightness level
get_icon_path() {
    local brightness=$1
    local level=$(( (brightness + 19) / 20 * 20 ))  # Round up to next 20

    if (( level > 100 )); then
        level=100
    fi
    
    echo "$iDIR/brightness-${level}.png"
}

# Get icons
get_icon() {
	current=$(get_kbd_backlight | sed 's/%//')

	if   [ "$current" -le "20" ]; then
		icon="$iDIR/brightness-20.png"
	elif [ "$current" -le "40" ]; then
		icon="$iDIR/brightness-40.png"
	elif [ "$current" -le "60" ]; then
		icon="$iDIR/brightness-60.png"
	elif [ "$current" -le "80" ]; then
		icon="$iDIR/brightness-80.png"
	else
		icon="$iDIR/brightness-100.png"
	fi
}

# Send notification
send_notification() {
    local brightness=$1
    local icon_path=$2

    notify-send -e \
        -h string:x-canonical-private-synchronous:osd \
        -h int:value:"$brightness" \
        -u low \
        -i "$icon_path" \
        "Screen" "Brightness: ${brightness}%"
}

# Notify
notify_user() {
	notify-send -e \
        -h string:x-canonical-private-synchronous:osd \
        -h int:value:$current \
        -h boolean:SWAYNC_BYPASS_DND:true \
        -u low \
        -i "$icon" \
        "Keyboard" "Brightness:$current%"
}

# Change brightness and notify
change_brightness() {
    local delta=$1
    local current new icon

    current=$(get_brightness)
    new=$((current + delta))

    # Clamp between 5 and 100
    (( new < 5 )) && new=5
    (( new > 100 )) && new=100

    brightnessctl set "${new}%"

    icon=$(get_icon_path "$new")
    send_notification "$new" "$icon"
}

# Change brightness
change_kbd_backlight() {
	brightnessctl -d *::kbd_backlight set "$1" && get_icon && notify_user
}

# Main
case "$1" in
    "--get")
        get_brightness
        ;;
    "--inc")
        change_brightness "$step"
        ;;
    "--dec")
        change_brightness "-$step"
        ;;
    "--get-kbd")
        get_kbd_backlight
        ;;
    "--inc-kbd")
        change_kbd_backlight "+30%"
        ;;
    "--dec-kbd")
        change_kbd_backlight "30%-"
        ;;
    *)
        get_brightness
        ;;
esac