#!/usr/bin/env bash
#  _____                 _       __        __          _
# |_   _|__   __ _  __ _| | ___  \ \      / /_ _ _   _| |__   __ _ _ __
#   | |/ _ \ / _` |/ _` | |/ _ \  \ \ /\ / / _` | | | | '_ \ / _` | '__|
#   | | (_) | (_| | (_| | |  __/   \ V  V / (_| | |_| | |_) | (_| | |
#   |_|\___/ \__, |\__, |_|\___|    \_/\_/ \__,_|\__, |_.__/ \__,_|_|
#            |___/ |___/                         |___/
#

settings_dir="${XDG_CONFIG_HOME:-$HOME/.config}/mimic/settings"

if [ -f "$settings_dir/waybar-disabled" ]; then
    rm "$settings_dir/waybar-disabled"
else
    touch "$settings_dir/waybar-disabled"
fi

m-restart-waybar
