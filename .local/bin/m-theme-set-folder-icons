#!/usr/bin/env bash

# Predefined colors
declare -A colors=(
  [adwaita]="147 192 234"
  [black]="79 79 79"
  [blue]="82 148 226"
  [bluegrey]="96 125 139"
  [breeze]="87 184 236"
  [brown]="174 142 108"
  [carmine]="163 0 2"
  [cyan]="0 188 212"
  [darkcyan]="69 171 183"
  [deeporange]="235 102 55"
  [green]="135 177 88"
  [grey]="142 142 142"
  [indigo]="92 107 192"
  [magenta]="202 113 223"
  [nordic]="129 161 193"
  [orange]="238 146 58"
  [palebrown]="209 191 174"
  [paleorange]="238 202 143"
  [pink]="240 98 146"
  [red]="226 82 82"
  [teal]="22 160 133"
  [violet]="126 87 194"
  [white]="228 228 228"
  [yaru]="103 103 103"
  [yellow]="249 189 48"
)

if [ $# -lt 1 ]; then
  echo "Usage: $0 <hexcolor>  (e.g. #416835, 416835, #416835FF)"
  exit 1
fi

hex=$(echo "$1" | sed -E 's/^#//; s/^(.{6}).*/\1/')
if ! [[ "$hex" =~ ^[0-9A-Fa-f]{6}$ ]]; then
  echo "Invalid hex color: $1"
  exit 2
fi

# Parse hex -> decimal RGB
R=$((16#${hex:0:2}))
G=$((16#${hex:2:2}))
B=$((16#${hex:4:2}))

# Prepare palette for awk
palette=""
for name in "${!colors[@]}"; do
  palette+="$name ${colors[$name]}"$'\n'
done

best=$(awk -v R="$R" -v G="$G" -v B="$B" '
function pow(x, y) { return x^y }
function srgb_to_lin(v) {
  v = v/255.0
  return (v <= 0.04045) ? v/12.92 : ((v+0.055)/1.055)^2.4
}
function rgb_to_xyz(r,g,b,   rl,gl,bl,X,Y,Z) {
  rl=srgb_to_lin(r); gl=srgb_to_lin(g); bl=srgb_to_lin(b)
  X = rl*0.4124564 + gl*0.3575761 + bl*0.1804375
  Y = rl*0.2126729 + gl*0.7151522 + bl*0.0721750
  Z = rl*0.0193339 + gl*0.1191920 + bl*0.9503041
  return X " " Y " " Z
}
function f_lab(t) { return (t>0.008856)? t^(1/3) : (7.787*t)+(16/116) }
function xyz_to_lab(X,Y,Z,   fx,fy,fz,L,a,b) {
  fx=f_lab(X/0.95047); fy=f_lab(Y/1.00000); fz=f_lab(Z/1.08883)
  L=116*fy-16; a=500*(fx-fy); b=200*(fy-fz)
  return L " " a " " b
}
function rgb_to_lab(r,g,b,   X,Y,Z) {
  split(rgb_to_xyz(r,g,b), xyz)
  split(xyz_to_lab(xyz[1],xyz[2],xyz[3]), lab)
  return lab[1] " " lab[2] " " lab[3]
}
function dist(l1,a1,b1,l2,a2,b2) {
  return sqrt((l1-l2)^2 + (a1-a2)^2 + (b1-b2)^2)
}

BEGIN {
  split(rgb_to_lab(R,G,B), target)
  bestd=1e9
}

{
  name=$1; r=$2; g=$3; b=$4
  split(rgb_to_lab(r,g,b), ref)
  d=dist(target[1],target[2],target[3], ref[1],ref[2],ref[3])
  if (d < bestd) { bestd = d; bestname = name }
}

END { print bestname }
' <<< "$palette")

papirus-folders -C "$best"
