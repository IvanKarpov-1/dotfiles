#!/usr/bin/env bash
#    ____         __       ____               __     __
#   /  _/__  ___ / /____ _/ / / __ _____  ___/ /__ _/ /____ ___
#  _/ // _ \(_-</ __/ _ `/ / / / // / _ \/ _  / _ `/ __/ -_|_-<
# /___/_//_/___/\__/\_,_/_/_/  \_,_/ .__/\_,_/\_,_/\__/\__/___/
#                                 /_/
#

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}"
settings_dir="${XDG_CONFIG_HOME:-$HOME/.config}/mimic/settings"

# Check if command exists
_checkCommandExists() {
    cmd="$1"
    if ! command -v "$cmd" >/dev/null; then
        echo 1
        return
    fi
    echo 0
    return
}

_isInstalled() {
    package="$1"
    case $install_platform in
        arch)
            check="$($aur_helper -Qs --color always "${package}" | grep "local" | grep "${package} ")"
            ;;
        fedora)
            check="$(dnf repoquery --quiet --installed ""${package}*"")"
            ;;
        *) ;;
    esac

    if [ -n "${check}" ]; then
        echo 0 #'0' means 'true' in Bash
        return #true
    fi
    echo 1 #'1' means 'false' in Bash
    return #false
}

# ------------------------------------------------------
# Confirm Start
# ------------------------------------------------------

sleep 1
clear
figlet -f smslant "Updates"
echo
primarycolor=$(cat "$config_dir/mimic/colors/primary")
onsurfacecolor=$(cat "$config_dir/mimic/colors/onsurface")
if gum confirm --selected.background=$primarycolor --prompt.foreground=$onsurfacecolor "DO YOU WANT TO START THE UPDATE NOW?"; then
    echo
    m-log ":: Update started..."
elif [ $? -eq 130 ]; then
    exit 130
else
    echo
    m-log ":: Update canceled."
    exit
fi

# ----------------------------------------------------- 
# Install update
# ----------------------------------------------------- 

# Arch
if [[ $(_checkCommandExists "pacman") == 0 ]]; then
    aur_helper="$(cat ~/.config/mimic/settings/aur.sh)"
    $aur_helper

# Fedora
elif [[ $(_checkCommandExists "dnf") == 0 ]]; then
    sudo dnf upgrade
else
    m-log "ERROR - Platform not supported"
    m-log "Press [ENTER] to close."
    read
fi
echo

# Flatpak
m-log "Searching for Flatpak updates..."
flatpak update
echo

# Reload Waybar
m-restart-waybar

# Finishing
m-log "Update complete! Press [ENTER] to close."
read
