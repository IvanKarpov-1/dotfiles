#!/usr/bin/env bash
#                _ _
# __      ____ _| | |_ __   __ _ _ __   ___ _ __
# \ \ /\ / / _` | | | '_ \ / _` | '_ \ / _ \ '__|
#  \ V  V / (_| | | | |_) | (_| | |_) |  __/ |
#   \_/\_/ \__,_|_|_| .__/ \__,_| .__/ \___|_|
#                   |_|         |_|
#
# -----------------------------------------------------
# Restore last wallpaper
# -----------------------------------------------------

# -----------------------------------------------------
# Set defaults
# -----------------------------------------------------

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}"

cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/mimic/hyprland-dotfiles"
cachefile="$cache_dir/current_wallpaper"
defaultwallpaper="$config_dir/mimic/wallpapers/default.jpg"

# -----------------------------------------------------
# Get current wallpaper
# -----------------------------------------------------

if [ -f "$cachefile" ]; then
    sed -i "s|~|$HOME|g" "$cachefile"
    wallpaper=$(cat "$cachefile")
    if [ -f "$wallpaper" ]; then
        m-log "Wallpaper $wallpaper exists"
    else
        m-log "Wallpaper $wallpaper does not exist. Using default."
        wallpaper="$defaultwallpaper"
    fi
else
    m-log "$cachefile does not exist. Using default wallpaper."
    wallpaper="$defaultwallpaper"
fi

# -----------------------------------------------------
# Set wallpaper
# -----------------------------------------------------

m-log "Setting wallpaper with source image $wallpaper"
waypaper --wallpaper "$wallpaper"
