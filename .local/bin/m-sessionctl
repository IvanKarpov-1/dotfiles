#!/usr/bin/env bash
#    ___                    
#   / _ \___ _    _____ ____
#  / ___/ _ \ |/|/ / -_) __/
# /_/   \___/__,__/\__/_/   
#                           

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}"

terminate_clients() {
  	TIMEOUT=5
	# Get a list of all client PIDs in the current Hyprland session
	client_pids=$(hyprctl clients -j | jq -r '.[] | .pid')

	# Send SIGTERM (kill -15) to each client PID and wait for termination
	for pid in $client_pids; do
		m-log "Sending SIGTERM to PID $pid"
		kill -15 $pid
	done

	start_time=$(date +%s)
	for pid in $client_pids; do
		# Wait for the process to terminate
		while kill -0 $pid 2>/dev/null; do
		current_time=$(date +%s)
		elapsed_time=$((current_time - start_time))

		if [ $elapsed_time -ge $TIMEOUT ]; then
			m-log "Timeout reached."
			return 0
		fi

		m-log "Waiting for PID $pid to terminate..."
		sleep 1
		done

		m-log "PID $pid has terminated."
	done
	bash $config_dir/mimic/listeners.sh --stopall
}

if [[ "$1" == "exit" ]]; then
	m-log "Exit"
	terminate_clients
	sleep 0.5
	hyprctl dispatch exit
	sleep 2
fi

if [[ "$1" == "lock" ]]; then
	m-log "Lock"
	sleep 0.5
	m-session-lock
fi

if [[ "$1" == "reboot" ]]; then
	m-log "Reboot"
	terminate_clients
	sleep 0.5
	systemctl reboot
fi

if [[ "$1" == "shutdown" ]]; then
	m-log "Shutdown"
	terminate_clients
	sleep 0.5
	systemctl poweroff
fi

if [[ "$1" == "suspend" ]]; then
	m-log "Suspend"
	sleep 0.5
	systemctl suspend
fi

if [[ "$1" == "hibernate" ]]; then
	m-log "Hibernate"
	sleep 1
	systemctl hibernate
fi
