{
    // General Settings
    "layer": "top",
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,
    "spacing": 0,
    // Load Modules
    "include": [
        "~/.config/mimic/settings/waybar-quicklinks.json",
        "~/.config/waybar/modules.json"
    ],
    // Modules Left
    "modules-left": [
        "custom/appmenuicon",
        "hyprland/workspaces",
        "group/quicklinks",
        "mpris",
        "custom/empty"
    ],
    // Modules Center
    "modules-center": [
        "hyprland/window",
        "custom/empty"
    ],
    // Modules Right    
    "modules-right": [
        "custom/updates",
        "privacy",
        "pulseaudio#output",
        "pulseaudio#input",
        //"backlight",
        "bluetooth",
        "network",
        "battery",
        "power-profiles-daemon",
        "custom/exit",
        "hyprland/language",
        "clock",
        "tray",
        "custom/notification"
    ]
}